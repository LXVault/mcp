# Copy to `.env` (or set these in your MCP client config) to configure the server.

# Base URL of the Express backend API (no trailing slash needed).
MCP_API_BASE_URL=http://localhost:4000/api

# Per-project access token. Generate one from the web app's
# "Access Tokens" page. Each token is scoped to a single project and lets the
# backend trace every action back to the user who created it.
MCP_API_TOKEN=mcp_your_token_here
