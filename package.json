{
  "name": "mcp-rag-mcp-server",
  "version": "1.1.0",
  "description": "Model Context Protocol server for the MCP RAG knowledge base. Authenticates with a per-project token so every action is traceable to a user.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-rag-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx .agents/wiki/context/mcp-tools.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "rag",
    "knowledge-base"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
